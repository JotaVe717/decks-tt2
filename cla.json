<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Membros do Clã - Tap Titans 2</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Arial, sans-serif;
    }
    body {
      background-color: #0f141c;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 30px 15px;
      min-height: 100vh;
    }
    .back-btn {
      align-self: flex-start;
      max-width: 820px;
      margin: 0 auto 16px auto;
      width: 100%;
      text-decoration: none;
      color: #8fa0b5;
      font-size: 14px;
      font-weight: 600;
      display: inline-block;
      transition: color 0.2s;
    }
    .back-btn:hover {
      color: #f5a623;
    }
    .container {
      width: 100%;
      max-width: 820px;
      background: #18202a;
      border: 1px solid #283545;
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    .title {
      text-align: center;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .title span {
      color: #f5a623;
    }
    .subtitle {
      text-align: center;
      font-size: 13px;
      color: #8fa0b5;
      margin-bottom: 24px;
    }
    .layout {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 16px;
    }
    .members-col {
      background: #212c3a;
      border: 1px solid #324357;
      border-radius: 10px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 540px;
      overflow-y: auto;
    }
    .member-btn {
      background: #18202a;
      border: 1px solid #324357;
      border-radius: 8px;
      padding: 10px 12px;
      color: #ffffff;
      font-size: 13px;
      font-weight: 600;
      text-align: left;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: border-color 0.2s, background 0.2s;
    }
    .member-btn:hover {
      border-color: #f5a623;
      background: #253344;
    }
    .member-btn.active {
      border-color: #4cd964;
      background: #1f3329;
    }
    .stats-col {
      background: #212c3a;
      border: 1px solid #324357;
      border-radius: 10px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .player-header {
      border-bottom: 1px solid #324357;
      padding-bottom: 12px;
    }
    .player-header h3 {
      font-size: 18px;
      color: #f5a623;
    }
    .player-header p {
      font-size: 12px;
      color: #8fa0b5;
      margin-top: 4px;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 10px;
    }
    .stat-card {
      background: #18202a;
      border: 1px solid #324357;
      border-radius: 8px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .stat-label {
      font-size: 11px;
      color: #8fa0b5;
      text-transform: uppercase;
      font-weight: 600;
    }
    .stat-value {
      font-size: 15px;
      font-weight: 700;
      color: #50e3c2;
    }
    .buff-section {
      border-top: 1px solid #324357;
      padding-top: 12px;
      display: flex;
      gap: 12px;
    }
    .buff-card {
      flex: 1;
      background: #18202a;
      border: 1px solid #324357;
      border-radius: 8px;
      padding: 10px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .buff-thumb {
      width: 40px;
      height: 40px;
      border-radius: 6px;
      object-fit: cover;
      background: #0f141c;
      border: 1px solid #3b4d63;
    }

    @media (max-width: 600px) {
      .layout {
        grid-template-columns: 1fr;
      }
      .members-col {
        max-height: 200px;
      }
    }
  </style>
</head>
<body>

  <a href="index.html" class="back-btn">&larr; Voltar ao Menu</a>

  <div class="container">
    <div class="title">Raid Clã: <span>Desempenho dos Membros</span></div>
    <div class="subtitle">Estatísticas oficiais de dano e ataques extraídas do TitanTech</div>

    <div class="layout">
      <!-- LISTA DE MEMBROS -->
      <div class="members-col" id="membersList">
        <p style="color: #8fa0b5; font-size: 12px; text-align: center;">A carregar cla.json...</p>
      </div>

      <!-- PAINEL DE ESTATÍSTICAS DO MEMBRO -->
      <div class="stats-col">
        <div class="player-header">
          <h3 id="selectedName">Selecione um jogador</h3>
          <p id="selectedInfo">Clique num membro da lista para inspecionar os detalhes de combate.</p>
        </div>

        <div class="stats-grid" id="statsGrid"></div>

        <div class="buff-section" id="buffSection" style="display: none;">
          <div class="buff-card">
            <img src="Cards/tt.png" class="buff-thumb" alt="Team Tactics">
            <div>
              <div class="stat-label">Team Tactics</div>
              <div class="stat-value" id="ttCount">0</div>
            </div>
          </div>
          <div class="buff-card">
            <img src="Cards/mf.png" class="buff-thumb" alt="Mirror Force">
            <div>
              <div class="stat-label">Mirror Force</div>
              <div class="stat-value" id="mfCount">0</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const API_URL = "cla.json";
    let clanMembers = [];

    function formatNumber(num) {
      return Number(num).toLocaleString('pt-PT');
    }

    async function carregarDadosCla() {
      const listContainer = document.getElementById("membersList");

      try {
        const response = await fetch(API_URL);
        if (!response.ok) {
          throw new Error(`Erro ao aceder a cla.json: ${response.status}`);
        }

        const data = await response.json();
        const rawList = data.players_data || data.players || (Array.isArray(data) ? data : []);

        clanMembers = rawList.map(m => ({
          id: m.player_id,
          name: m.player_name || "Jogador",
          totalDamage: m.total_damage || 0,
          averageDamage: m.average_damage || 0,
          maxDamage: m.max_damage || 0,
          minDamage: m.min_damage || 0,
          attackCount: m.attack_count || 0,
          ttUsed: m.team_tactics_used || 0,
          mfUsed: m.mirror_force_used || 0
        }));

        // Ordena por ordem decrescente de dano total
        clanMembers.sort((a, b) => b.totalDamage - a.totalDamage);
        renderMembers();
      } catch (err) {
        console.error("Falha ao carregar cla.json:", err);
        listContainer.innerHTML = `
          <p style="color: #ff5e57; font-size: 12px; text-align: center; padding: 10px;">
            Não foi possível ler o ficheiro cla.json.<br>
            <small style="color: #8fa0b5;">Confirme se o ficheiro está na mesma pasta do projeto e abra através do Live Server.</small>
          </p>
        `;
      }
    }

    function renderMembers() {
      const listContainer = document.getElementById("membersList");
      listContainer.innerHTML = "";

      if (clanMembers.length === 0) {
        listContainer.innerHTML = '<p style="color: #8fa0b5; font-size: 12px; text-align: center;">Nenhum membro encontrado.</p>';
        return;
      }

      clanMembers.forEach((member, index) => {
        const btn = document.createElement("button");
        btn.className = "member-btn";
        btn.innerHTML = `<span>${member.name}</span><small style="color:#50e3c2;">${member.attackCount} atq</small>`;
        btn.onclick = () => selectMember(member, btn);
        listContainer.appendChild(btn);

        if (index === 0) selectMember(member, btn);
      });
    }

    function selectMember(member, btnElement) {
      document.querySelectorAll(".member-btn").forEach(b => b.classList.remove("active"));
      if (btnElement) btnElement.classList.add("active");

      document.getElementById("selectedName").textContent = member.name;
      document.getElementById("selectedInfo").textContent = `ID: ${member.id}`;

      const grid = document.getElementById("statsGrid");
      grid.innerHTML = `
        <div class="stat-card">
          <span class="stat-label">Dano Total</span>
          <span class="stat-value" style="color: #f5a623;">${formatNumber(member.totalDamage)}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Dano Médio</span>
          <span class="stat-value">${formatNumber(member.averageDamage)}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Ataques Feitos</span>
          <span class="stat-value">${member.attackCount}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Maior Dano</span>
          <span class="stat-value">${formatNumber(member.maxDamage)}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Menor Dano</span>
          <span class="stat-value">${formatNumber(member.minDamage)}</span>
        </div>
      `;

      document.getElementById("buffSection").style.display = "flex";
      document.getElementById("ttCount").textContent = `${member.ttUsed}x`;
      document.getElementById("mfCount").textContent = `${member.mfUsed}x`;
    }

    carregarDadosCla();
  </script>
</body>
</html>